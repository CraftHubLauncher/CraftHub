{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: CraftHub's own typed commands plus event listening. No shell, fs, http or opener access from the web view.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-environment",
    "allow-list-apps",
    "allow-check-for-updates",
    "allow-get-versions",
    "allow-install-app",
    "allow-update-app",
    "allow-update-all",
    "allow-uninstall-app",
    "allow-rollback-app",
    "allow-launch-app",
    "allow-cancel-operation",
    "allow-open-releases-page",
    "allow-open-install-folder",
    "allow-open-logs-folder",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-history",
    "allow-clear-release-cache",
    "allow-choose-install-root",
    "allow-reset-install-root",
    "allow-choose-app-install-root",
    "allow-get-shortcut-status",
    "allow-create-shortcut",
    "allow-remove-shortcut",
    "allow-exit-app",
    "allow-get-self-update-status",
    "allow-check-self-update",
    "allow-install-self-update"
  ]
}
